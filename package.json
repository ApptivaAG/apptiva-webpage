{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "tsc --noEmit && biome check src",
    "format": "biome format src --write",
    "vulns": "snyk test --severity-threshold=high --file=package.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "email:dev": "email dev --dir src/components/contact-form --port 3001",
    "resend:catch": "node script/resend-catcher.mjs"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@portabletext/react": "^4.0.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^8.9.0",
    "@sanity/code-input": "^7.3.12",
    "@sanity/image-url": "^2.1.1",
    "@sanity/react-loader": "^2.2.3",
    "@sanity/ui": "^4.4.9",
    "@sanity/vision": "^6.19.0",
    "@szhsin/react-accordion": "^1.4.3",
    "bright": "^0.8.6",
    "class-variance-authority": "^0.7.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "groqd": "^1.7.1",
    "next": "^16.4.2",
    "next-mdx-remote": "^6.0.0",
    "next-plausible": "^3.12.5",
    "next-sanity": "^13.3.4",
    "nuqs": "^2.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.5",
    "react-error-boundary": "^4.1.2",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^9.16.0",
    "react-schemaorg": "^2.0.1",
    "resend": "^6.34.1",
    "sanity": "^6.19.0",
    "sanity-plugin-media": "^6.3.5",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.5",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "30.1.3",
    "postcss": "^8.5.31",
